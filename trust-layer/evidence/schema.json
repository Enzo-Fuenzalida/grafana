{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:flylo-air:trust-layer:evidence:v1",
  "title": "TrustLayerEvidenceRecord",
  "description": "One agent-produced evidence record for one control on one commit. A pass without an artifact is invalid.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "control_id",
    "policy_refs",
    "sdlc_stage",
    "repository",
    "pull_request",
    "commit_sha",
    "check",
    "result",
    "artifacts",
    "agent",
    "timestamp",
    "attestation"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "control_id": { "type": "string", "pattern": "^TL-[A-Z]+-[0-9]{3}$" },
    "policy_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^(POL|STD)-[A-Z0-9]+(?:-[A-Z0-9]+)+$" }
    },
    "standard_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^STD-[A-Z0-9]+(?:-[A-Z0-9]+)+$" }
    },
    "sdlc_stage": { "enum": ["test", "review", "release"] },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "pull_request": { "type": "integer", "minimum": 1 },
    "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "summary"],
      "properties": {
        "method": { "enum": ["automated", "manual", "hybrid"] },
        "summary": { "type": "string", "minLength": 1 },
        "procedure_ref": { "type": "string", "pattern": "^STD-[A-Z0-9]+(?:-[A-Z0-9]+)+$" }
      }
    },
    "result": { "enum": ["pass", "fail", "gap", "waived"] },
    "finding": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "uri"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "uri": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["not_required", "attested", "missing"] },
        "reviewer": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approver", "expires", "residual_risk", "policy_refs"],
      "properties": {
        "approver": { "type": "string", "minLength": 1 },
        "expires": { "type": "string", "format": "date-time" },
        "residual_risk": { "type": "string", "minLength": 1 },
        "policy_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^(POL|STD)-[A-Z0-9]+(?:-[A-Z0-9]+)+$" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": ["result"],
        "properties": { "result": { "const": "pass" } }
      },
      "then": {
        "type": "object",
        "properties": { "artifacts": { "type": "array", "minItems": 1 } }
      }
    },
    {
      "if": {
        "type": "object",
        "required": ["result"],
        "properties": { "result": { "enum": ["fail", "gap"] } }
      },
      "then": {
        "type": "object",
        "required": ["finding"]
      }
    },
    {
      "if": {
        "type": "object",
        "required": ["result"],
        "properties": { "result": { "const": "waived" } }
      },
      "then": {
        "type": "object",
        "required": ["waiver", "finding"]
      }
    },
    {
      "if": {
        "type": "object",
        "required": ["check"],
        "properties": {
          "check": {
            "type": "object",
            "required": ["method"],
            "properties": { "method": { "enum": ["manual", "hybrid"] } }
          }
        }
      },
      "then": {
        "type": "object",
        "required": ["attestation"],
        "properties": {
          "attestation": {
            "type": "object",
            "required": ["status", "reviewer", "statement", "timestamp"],
            "properties": { "status": { "const": "attested" } }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": ["attestation"],
        "properties": {
          "attestation": {
            "type": "object",
            "required": ["status"],
            "properties": { "status": { "const": "attested" } }
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "attestation": {
            "type": "object",
            "required": ["reviewer", "statement", "timestamp"]
          }
        }
      }
    }
  ]
}
